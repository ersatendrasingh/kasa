NEXT_PUBLIC_DEMO_APP_URL="https://cwk.getkasa.in"
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID="ca-pub-2007753908126813"
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-5-mini
DATABASE_URL="postgresql://user:password@localhost:5432/kasa"
AUTH_SECRET="replace-with-a-long-random-auth-secret"
RESEND_API_KEY="re_your_resend_api_key"
LEADS_FROM_EMAIL="KASA <support@getkasa.in>"
LEADS_NOTIFICATION_EMAIL="team@getkasa.in"
# Primary article image delivery. Cloudinary is the default storage provider.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# Optional: defaults to kasa/articles.
CLOUDINARY_ARTICLE_MEDIA_FOLDER="kasa/articles"
# Existing S3 remains available as a selectable provider and Cloudinary fallback.
ARTICLE_MEDIA_S3_BUCKET="your-article-media-bucket"
ARTICLE_MEDIA_S3_REGION="ap-south-1"
ARTICLE_MEDIA_S3_ACCESS_KEY_ID="your-s3-access-key"
ARTICLE_MEDIA_S3_SECRET_ACCESS_KEY="your-s3-secret-key"
# Optional for Cloudflare R2/MinIO/custom S3-compatible storage.
ARTICLE_MEDIA_S3_ENDPOINT=""
ARTICLE_MEDIA_S3_FORCE_PATH_STYLE="false"
ARTICLE_MEDIA_PUBLIC_BASE_URL="https://cdn.getkasa.in"
